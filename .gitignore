# Planning and working notes stay local. Excluded from the first commit rather
# than removed later, because git history is permanent — a file committed now is
# public the moment the repo is, whether or not it still exists at HEAD.
project-1-xrechnung.md
SPIKE.md
notes/

# Local editor / tooling state
.claude/

# Ruleset artifacts are fetched, hashed and recorded — never committed.
# manifest.json IS committed: it is the provenance record behind ruleset_sha256.
# Note the pattern: `rulesets/*/` would stop git descending into the directory,
# so the negation below could never match. `rulesets/*/**` ignores the contents
# while leaving the directory traversable.
rulesets/*/**
!rulesets/*/manifest.json

# Test corpus is fetched from the KoSIT testsuite release.
tests/corpus/_downloaded/

# Spike output
.spike-out/
spike-results.json

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

node_modules/
frontend/dist/
frontend/*.tsbuildinfo

.env
.env.*
!.env.example

# Locally generated sample invoices, derived from the fetched corpus. Anchored to
# the root: the three demo files under frontend/public/samples/ are shipped assets
# that the page loads, and an unanchored pattern silently excluded them from the
# image CI builds while a local build picked them up off disk.
/samples/

# Per-batch review sheets. Working artifacts for one review round, regenerated
# by review_sheet.py --only in one command. The full sheet is committed; forty
# batch sheets beside it would be noise.
docs/review/*.batch-*.md

# Agent handoff notes. Kept local: it names the private planning doc and
# carries internal links that do not belong in a repo destined to be public.
CLAUDE.md
